{
	"name": "@rm-netsu/esm-chatcompletions-client",
	"version": "0.2.3",
	"description": "A lightweight, zero-dependency ESM client library for the Chat Completions API",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"publishConfig": {
		"registry": "https://npm.pkg.github.com",
		"access": "public"
	},
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
		"build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
		"build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "biome lint src",
		"lint:fix": "biome lint --write src",
		"format": "biome format --write src README.md",
		"format:check": "biome format src README.md"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.8",
		"typescript": "5.9.3"
	},
	"keywords": [
		"openai",
		"chatgpt",
		"chatcompletions",
		"llm",
		"ai",
		"client",
		"esm"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rm-netsu/esm-chatcompletions-client.git"
	},
	"author": "rm-netsu",
	"engines": {
		"node": ">=18.0.0",
		"bun": ">=1.0.0"
	}
}
